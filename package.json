{
  "name": "hyperxgt",
  "version": "1.0.0",
  "private": true,
  "description": "HyperXGT RC storefront — static pages plus Node serverless API routes.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "check:syntax": "node scripts/check-syntax.js",
    "check:handlers": "node scripts/check-handlers.js",
    "check:pages": "bash scripts/check-pages.sh",
    "check": "npm run check:syntax && npm run check:handlers"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "xlsx": "^0.18.5"
  }
}
